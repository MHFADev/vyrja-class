#!/bin/sh
# Windows packaging steps for Vyrja Classroom (Veyon fork).
#
# Generated by CMake from .ci/windows/windows-packaging.sh.in - do not edit
# the generated copy (windows-packaging.sh in the build directory).
#
# These steps are plain POSIX shell commands. They used to be listed as
# add_custom_target() commands in cmake/modules/WindowsInstaller.cmake, but
# on native Windows hosts (MSYS2) CMake/Ninja execute custom target commands
# through cmd.exe, which rejects them with "The syntax of the command is
# incorrect.". Running them from a real shell script works on both the
# upstream Linux cross-compile host and native MSYS2 hosts.
set -e

CMAKE_BINARY_DIR="@CMAKE_BINARY_DIR@"
CMAKE_SOURCE_DIR="@CMAKE_SOURCE_DIR@"
CMAKE_COMMAND="@CMAKE_COMMAND@"
INSTALL_DIR="@WINDOWS_INSTALL_FILES@"
DLLDIR="@DLLDIR@"
DLLDIR_LIB="@DLLDIR_LIB@"
DLLDIR_GCC="@DLLDIR_GCC@"
MINGW_PREFIX="@MINGW_PREFIX@"
MINGW_TOOL_PREFIX="@MINGW_TOOL_PREFIX@"
DLL_GCC="@DLL_GCC@"
DLL_DDENGINE="@DLL_DDENGINE@"

cd "${CMAKE_BINARY_DIR}"

# find_dll <name-or-glob> - print the path of a runtime DLL in the MinGW
# prefix. Its exact name and location differ between the upstream cross
# sysroot and native MSYS2 packages (e.g. libjpeg-62.dll vs libjpeg-8.dll,
# bin vs lib vs gcc lib dir), so callers may pass alternative names/globs.
find_dll() {
	for dir in "${DLLDIR}" "${DLLDIR_LIB}" "${DLLDIR_GCC}"; do
		for f in "${dir}"/$1; do
			if [ -f "$f" ]; then
				echo "$f"
				return 0
			fi
		done
	done
	return 1
}

# cp_dll <destdir> <name-or-glob> [alternatives...] - copy the first
# matching runtime DLL from the prefix. Fails loudly when no candidate
# is present at all.
cp_dll() {
	dest="$1"; shift
	for name in "$@"; do
		if f=$(find_dll "${name}"); then
			cp "$f" "${dest}"
			return 0
		fi
	done
	echo "error: runtime DLL not found in MinGW prefix (tried: $*)" >&2
	return 1
}

# cp_dll_optional <destdir> <name-or-glob> [alternatives...] - copy a DLL
# only when it exists in the prefix (for libraries that only some build
# configurations link against).
cp_dll_optional() {
	cp_dll "$@" || true
}

# qt_plugins_dir - locate the Qt6 plugins directory of the prefix (its
# layout differs between MSYS2 and the upstream cross sysroot).
qt_plugins_dir() {
	for dir in "${MINGW_PREFIX}/share/qt6/plugins" "${MINGW_PREFIX}/lib/qt6/plugins" "${MINGW_PREFIX}/plugins"; do
		if [ -f "${dir}/platforms/qwindows.dll" ]; then
			echo "${dir}"
			return 0
		fi
	done
	echo "error: Qt6 plugins directory (platforms/qwindows.dll) not found under ${MINGW_PREFIX}" >&2
	return 1
}

case "$1" in
staging)
	rm -rf ${INSTALL_DIR}*
	mkdir -p ${INSTALL_DIR}/interception
	# regular files only - the directory can contain source subdirectories
	# (e.g. the vendored Interception library)
	find "${CMAKE_SOURCE_DIR}/3rdparty/interception" -maxdepth 1 -type f -exec cp {} ${INSTALL_DIR}/interception/ ';'
	cp "${CMAKE_SOURCE_DIR}/3rdparty/ddengine/${DLL_DDENGINE}" ${INSTALL_DIR}
	cp core/veyon-core.dll ${INSTALL_DIR}
	find . -mindepth 2 -name 'veyon-*.exe' -not -path "./${INSTALL_DIR}/*" -exec cp '{}' ${INSTALL_DIR}/ ';'
	mkdir -p ${INSTALL_DIR}/plugins
	find plugins/ -name '*.dll' -exec cp '{}' ${INSTALL_DIR}/plugins/ ';'
	for dll in ${INSTALL_DIR}/plugins/lib*.dll; do
		if [ -f "${dll}" ]; then
			mv "${dll}" ${INSTALL_DIR}
		fi
	done
	mv ${INSTALL_DIR}/plugins/vnchooks.dll ${INSTALL_DIR}
	mkdir -p ${INSTALL_DIR}/translations
	if [ -d translations ]; then
		"${CMAKE_COMMAND}" -E copy_directory translations ${INSTALL_DIR}/translations
	fi
	cp_dll ${INSTALL_DIR} libjpeg-62.dll libjpeg-8.dll
	cp_dll ${INSTALL_DIR} libpng16-16.dll
	cp_dll ${INSTALL_DIR} 'libcrypto-3*.dll'
	cp_dll ${INSTALL_DIR} 'libssl-3*.dll'
	cp_dll ${INSTALL_DIR} libqca-qt6.dll
	cp_dll ${INSTALL_DIR} libsasl2-3.dll
	cp_dll ${INSTALL_DIR} libldap.dll 'libldap-2.5-0.dll' 'libldap-2.6-0.dll'
	cp_dll ${INSTALL_DIR} liblber.dll 'liblber-2.5-0.dll' 'liblber-2.6-0.dll' 
	# interception.dll only exists when linking the Interception SDK as a
	# shared library - the vendored static library needs no runtime DLL
	if [ -f "${DLLDIR}/interception.dll" ]; then
		cp "${DLLDIR}/interception.dll" ${INSTALL_DIR}
	fi
	cp_dll ${INSTALL_DIR} liblzo2-2.dll
	cp_dll ${INSTALL_DIR} libvncclient.dll
	cp_dll ${INSTALL_DIR} libvncserver.dll
	cp_dll ${INSTALL_DIR} zlib1.dll
	cp_dll ${INSTALL_DIR} libwinpthread-1.dll
	cp_dll ${INSTALL_DIR} libstdc++-6.dll
	cp_dll ${INSTALL_DIR} libssp-0.dll
	cp_dll ${INSTALL_DIR} ${DLL_GCC}
	mkdir -p ${INSTALL_DIR}/crypto
	QCA_CRYPTO=""
	for dir in "${DLLDIR_LIB}/qca-qt6/crypto" "${DLLDIR}/qca-qt6/crypto" "${MINGW_PREFIX}/lib/qt6/plugins/crypto"; do
		if [ -f "${dir}/libqca-ossl.dll" ]; then
			QCA_CRYPTO="${dir}/libqca-ossl.dll"
			break
		fi
	done
	if [ -z "${QCA_CRYPTO}" ]; then
		echo "error: libqca-ossl.dll not found in the MinGW prefix" >&2
		exit 1
	fi
	cp "${QCA_CRYPTO}" ${INSTALL_DIR}/crypto
	cp_dll ${INSTALL_DIR} Qt6Core.dll
	cp_dll ${INSTALL_DIR} Qt6Core5Compat.dll
	cp_dll ${INSTALL_DIR} Qt6Gui.dll
	cp_dll ${INSTALL_DIR} Qt6Widgets.dll
	cp_dll ${INSTALL_DIR} Qt6Network.dll
	cp_dll ${INSTALL_DIR} Qt6Concurrent.dll
	# only present/needed when the corresponding Qt module is in the prefix
	cp_dll_optional ${INSTALL_DIR} Qt6HttpServer.dll
	cp_dll_optional ${INSTALL_DIR} Qt6WebSockets.dll
	QT_PLUGINS=$(qt_plugins_dir)
	mkdir -p ${INSTALL_DIR}/imageformats
	cp "${QT_PLUGINS}/imageformats/qjpeg.dll" ${INSTALL_DIR}/imageformats
	mkdir -p ${INSTALL_DIR}/platforms
	cp "${QT_PLUGINS}/platforms/qwindows.dll" ${INSTALL_DIR}/platforms
	mkdir -p ${INSTALL_DIR}/styles
	cp "${QT_PLUGINS}"/styles/*.dll ${INSTALL_DIR}/styles
	mkdir -p ${INSTALL_DIR}/tls
	cp "${QT_PLUGINS}/tls/qopensslbackend.dll" ${INSTALL_DIR}/tls
	"${MINGW_TOOL_PREFIX}strip" ${INSTALL_DIR}/*.dll ${INSTALL_DIR}/*.exe ${INSTALL_DIR}/plugins/*.dll ${INSTALL_DIR}/platforms/*.dll ${INSTALL_DIR}/styles/*.dll ${INSTALL_DIR}/crypto/*.dll
	cp "${CMAKE_SOURCE_DIR}/COPYING" ${INSTALL_DIR}
	cp "${CMAKE_SOURCE_DIR}/COPYING" ${INSTALL_DIR}/LICENSE.TXT
	cp "${CMAKE_SOURCE_DIR}/README.md" ${INSTALL_DIR}/README.TXT
	if command -v todos >/dev/null 2>&1; then
		todos ${INSTALL_DIR}/*.TXT
	else
		unix2dos ${INSTALL_DIR}/*.TXT
	fi
	cp -ra "${CMAKE_SOURCE_DIR}/nsis" ${INSTALL_DIR}
	cp "${CMAKE_BINARY_DIR}/nsis/veyon.nsi" ${INSTALL_DIR}
	find ${INSTALL_DIR} -ls
	;;
installer)
	makensis ${INSTALL_DIR}/veyon.nsi
	mv ${INSTALL_DIR}/vyrja-classroom-*setup.exe .
	rm -rf ${INSTALL_DIR}
	;;
devnsi)
	sed -i ${INSTALL_DIR}/veyon.nsi -e "s,/SOLID lzma,zlib,g"
	;;
*)
	echo "usage: $0 {staging|installer|devnsi}" >&2
	exit 1
	;;
esac
